# Токен от @BotFather (обязательно)
BOT_TOKEN=123456789:replace_me

# Публичный адрес сервиса. Если не задан — берётся RENDER_EXTERNAL_URL,
# а если и его нет — бот запускается в режиме long polling
WEBHOOK_BASE_URL=

# Секрет вебхука (A-Z, a-z, 0-9, _ и -). Если пусто — генерируется при старте
WEBHOOK_SECRET=

# Порт HTTP-сервера
PORT=8080

# Строка подключения к PostgreSQL (Supabase: Connect → Direct → Session pooler).
# Если пусто — бот работает без базы
DATABASE_URL=
